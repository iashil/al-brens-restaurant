rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Menu items ── Public read, Auth-only write with validation
    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['name','emoji','price','description','includes','category','available','order'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 100000
        && request.resource.data.category is string
        && request.resource.data.available is bool;
      allow delete: if request.auth != null;
    }

    // ── Special Offers ── Public read, Auth-only write with validation
    match /offers/{offerId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['name','badge','description','includes','price','active'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.active is bool;
      allow delete: if request.auth != null;
    }

    // ── Settings ── Public read, Auth-only write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
